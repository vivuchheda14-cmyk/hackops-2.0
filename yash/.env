# ==============================================================================
# EcoSentinel Environment Configuration Template
# Copy this file to '.env' in the same folder and insert your credentials.
# NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# data.gov.in API Key (Register and obtain your free key at https://data.gov.in)
DATAGOV_API_KEY=your_data_gov_in_api_key_here

# data.gov.in Resource ID for CPCB Real-time Air Quality Index
# Default resource ID for National Air Quality Index (NAQI) published by CPCB:
DATAGOV_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Base API endpoint URL for data.gov.in resource queries
DATAGOV_BASE_URL=https://api.data.gov.in/resource

# API Request Timeout in seconds (prevents Streamlit dashboard from hanging)
API_TIMEOUT_SECONDS=10

